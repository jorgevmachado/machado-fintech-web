{
  "name": "@fintech/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "build": "npm run build:components && npm run build:styles",
    "test": "jest --config jest.config.ts --coverage",
    "test:watch": "jest --watchAll",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc -b",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@fintech/eslint-config": "workspace:*",
    "@fintech/icons": "workspace:*",
    "@fintech/jest-config": "workspace:*",
    "@fintech/tailwind-config": "workspace:*",
    "@fintech/theme": "workspace:*",
    "@fintech/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4.3.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@fintech/i18n": "workspace:*",
    "@fintech/shared": "workspace:*",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
